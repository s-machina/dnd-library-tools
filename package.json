{
  "name": "dnd-library-tools",
  "version": "1.0.0",
  "description": "Tools to work with D&D sourcebooks from 5etools as an AI reference library",
  "type": "module",
  "scripts": {
    "list": "node src/list.js",
    "convert": "node src/convert.js",
    "toc": "node src/toc.js",
    "toc:build": "node src/toc.js build ./5etools-data",
    "index": "node src/index.js",
    "index:build": "node src/index.js build ./5etools-data",
    "mcp": "node src/mcp-server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "dnd",
    "5e",
    "sourcebooks",
    "5etools"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "better-sqlite3": "^12.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
